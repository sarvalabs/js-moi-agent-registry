{
  "name": "@sarvalabs/js-moi-agent-registry",
  "version": "0.1.0",
  "description": "TypeScript SDK for the AgentRegistryLogic contract on MOI — protocol-agnostic on-chain agent registry",
  "main": "./lib.cjs/index.js",
  "module": "./lib.esm/index.js",
  "types": "./lib.cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib.esm/index.d.ts",
      "require": "./lib.cjs/index.js",
      "import": "./lib.esm/index.js"
    }
  },
  "files": [
    "lib.cjs",
    "lib.esm",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json; tsc -p tsconfig.esm.json; node -e \"require('fs').writeFileSync('lib.esm/package.json', JSON.stringify({type:'module'}))\"",
    "dev": "tsc -p tsconfig.cjs.json --watch",
    "clean": "rm -rf lib.cjs lib.esm",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "moi",
    "agent-registry",
    "a2a",
    "mcp",
    "web3",
    "sdk"
  ],
  "license": "MIT",
  "publishConfig": {
  "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sarvalabs/js-moi-agent-registry"
  },
  "peerDependencies": {
    "js-moi-sdk": ">=0.7.0-rc15"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}